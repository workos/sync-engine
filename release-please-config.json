{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "plugins": [
    "node-workspace"
  ],
  "packages": {
    "packages/sync-engine": {
      "release-type": "node",
      "component": "sync-engine",
      "extra-files": [
        "src/version.ts"
      ]
    },
    "packages/sync-postgres": {
      "release-type": "node",
      "component": "sync-postgres"
    },
    "packages/sync-mysql": {
      "release-type": "node",
      "component": "sync-mysql"
    },
    "packages/sync-clickhouse": {
      "release-type": "node",
      "component": "sync-clickhouse"
    }
  }
}
