# Build, typecheck and test only what this push changed: the packages with
# changed files since the branch left its upstream (or main, before the first
# push), and the packages that depend on them, which is what pnpm's `...[ref]`
# filter selects. A change to a file every package shares (the lockfile, the
# workspace file, a root config) runs everything, as CI does.
set -e

base=$(git merge-base HEAD '@{upstream}' 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || true)
if [ -z "$base" ]; then
  echo "pre-push: no upstream or origin/main to compare against; running everything"
  pnpm run build && pnpm run typecheck && pnpm test
  exit 0
fi

shared=$(git diff --name-only "$base" HEAD -- . ':!packages' ':!examples' ':!docs' ':!*.md' ':!.github' ':!.husky' ':!.claude' | head -1)
if [ -n "$shared" ]; then
  echo "pre-push: $shared changed, which every package shares; running everything"
  pnpm run build && pnpm run typecheck && pnpm test
  exit 0
fi

changed=$(pnpm --filter "...[$base]" exec pwd 2>/dev/null | wc -l | tr -d ' ')
if [ "$changed" = "0" ]; then
  echo "pre-push: no package changed since $(git rev-parse --short "$base"); nothing to run"
  exit 0
fi
echo "pre-push: $changed package(s) changed since $(git rev-parse --short "$base")"
pnpm --filter "...[$base]" run build
pnpm --filter "...[$base]" run typecheck
pnpm --filter "...[$base]" run test
