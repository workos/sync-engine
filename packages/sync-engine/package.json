{
  "name": "@workos/sync-engine",
  "version": "0.0.1",
  "description": "Engine-agnostic core for mirroring WorkOS data: stream catalog, event routing, backfill, tail and reconcile. Pair with a destination package such as @workos/sync-postgres.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workos/workos-pg-sync.git",
    "directory": "packages/sync-engine"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@workos/openapi-spec": "^0.143.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
