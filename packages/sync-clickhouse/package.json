{
  "name": "@workos/sync-clickhouse",
  "version": "0.0.0",
  "description": "Mirror your WorkOS data into ClickHouse. Backfill, tail the Events API, and reconcile drift.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workos/sync-engine.git",
    "directory": "packages/sync-clickhouse"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "workos-sync-clickhouse": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:database": "node -e \"if (!process.env.TEST_CLICKHOUSE_URL) { console.error('TEST_CLICKHOUSE_URL is required'); process.exit(1) }\" && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workos/sync-engine": "workspace:*",
    "@clickhouse/client": "^1.11.0"
  },
  "optionalDependencies": {
    "@opentelemetry/sdk-node": "^0.300.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
