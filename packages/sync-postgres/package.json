{
  "name": "@workos/sync-postgres",
  "version": "0.1.0",
  "description": "Mirror your WorkOS data into Postgres. Backfill, tail the Events API, and reconcile drift.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workos/sync-engine.git",
    "directory": "packages/sync-postgres"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "workos-sync-postgres": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:database": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required'); process.exit(1) }\" && vitest run test/compatibility-postgres.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workos/sync-engine": "workspace:*",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1"
  },
  "optionalDependencies": {
    "@opentelemetry/sdk-node": "^0.300.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
