# Kept out of the image build context. The manifests stage in the Dockerfile
# finds every package.json, so each workspace package must stay in the context
# even when only its manifest is used: examples/ is in the lockfile.
.git
.github
.vscode
.DS_Store
*.log
docs
node_modules
**/node_modules
**/dist
**/test
**/vitest.config.ts
examples/**/*.ts
examples/**/tsconfig.json
.release-please-manifest.json
release-please-config.json
Dockerfile
.dockerignore
