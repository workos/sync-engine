{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": ["dist/", "node_modules/", "pnpm-lock.yaml", "**/*.json", "**/*.md", "**/*.yaml", "**/*.yml"]
}
